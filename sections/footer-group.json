oopener noreferrer\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0945/3777/7336/files/norton-light.png?v=1775324009\" loading=\"lazy\">\n      </a>\n\n      <img src=\"https://images.dmca.com/Badges/dmca_protected_25_120.png?ID=ace3d9bd-34cf-4077-b757-58e0cc5dd38e\" loading=\"lazy\" />\n      \n    </div>\n\n    <script src=\"https://images.dmca.com/Badges/DMCABadgeHelper.min.js\"></script>\n\n    <div style=\"margin-top: 15px;\" class=\"futureblink-badge-block\" id=\"09b9a2d6-47ff-4a71-a95a-a967194482a2\"></div>\n  </div>\n</div>\n\n<script>\n(function() {\n  function updateDiscount() {\n    const mainProductSection = document.querySelector(\".shopify-section--main-product\");\n    if (!mainProductSection) return;\n\n    const priceList = mainProductSection.querySelector(\"price-list\");\n    if (!priceList) return;\n\n    const salePriceElement = priceList.querySelector(\"sale-price\");\n    const compareAtPriceElement = priceList.querySelector(\"compare-at-price\");\n    \n    let discountBox = mainProductSection.querySelector(\".custom-discount-box\");\n\n    if (salePriceElement && compareAtPriceElement) {\n      const parsePrice = (el) => {\n        const text = el.innerText.replace(/[^\\\\d,.]/g, \"\").replace(\",\", \".\");\n        return parseFloat(text);\n      };\n\n      const salePrice = parsePrice(salePriceElement);\n      const comparePrice = parsePrice(compareAtPriceElement);\n\n      if (comparePrice > salePrice) {\n        const discount = Math.round(((comparePrice - salePrice) / comparePrice) * 100);\n        \n        if (!discountBox) {\n          discountBox = document.createElement(\"span\");\n          discountBox.className = \"custom-discount-box\";\n          compareAtPriceElement.parentNode.insertBefore(discountBox, compareAtPriceElement.nextSibling);\n        }\n        \n        discountBox.innerHTML = `${discount}% OFF`;\n        discountBox.style.display = \"inline-flex\"; \n      } else if (discountBox) {\n        discountBox.style.display = \"none\";\n      }\n    } else if (discountBox) {\n      discountBox.style.display = \"none\";\n    }\n  }\n\n  let isUpdating = false;\n  const runLogic = () => {\n    if (isUpdating) return;\n    isUpdating = true;\n    setTimeout(() => {\n      updateDiscount();\n      isUpdating = false;\n    }, 200);\n  };\n\n  window.addEventListener(\"DOMContentLoaded\", runLogic);\n\n  const observer = new MutationObserver(runLogic);\n  observer.observe(document.body, { childList: true, subtree: true });\n\n  if (document.readyState === \"complete\" || document.readyState === \"interactive\") {\n    runLogic();\n  }\n})();\n</script>\n\n<style>\n  .custom-discount-box {\n    display: inline-flex;\n    align-items: center;\n    background-color: #1c1c1c;\n    color: #ffffff;\n    padding: 0.15rem 0.4rem;\n    font-size: 0.75rem;\n    font-weight: bold;\n    text-transform: uppercase;\n    line-height: 1.2;\n  }\n  \n  compare-at-price {\n    display: inline-flex;\n    align-items: center;\n  }\n</style>",
